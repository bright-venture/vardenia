# Generated by Payload on every dev server start. Formatting it here starts a
# loop: Prettier rewraps the lines, Payload rewrites them back, and the file
# shows up as an uncommitted change nobody made. Payload owns this file.
apps/web/src/app/(payload)/admin/importMap.js

# Generated by `payload generate:types`, and gitignored anyway.
apps/web/src/payload-types.ts

# Drizzle schema snapshots, written by `payload migrate:create`. Same loop as
# importMap.js above, except each one is a quarter of a megabyte: Prettier
# rewraps them, the next generated migration writes them back, and CI fails on
# a file nobody typed. They are committed because `migrate:create` diffs
# against them to work out what changed, and read by nothing else.
#
# The migration .ts files next to them are hand-edited, so they stay checked.
# So does index.ts, for the same reason - the generator rewrites it, but the
# ordering comment in it is restored by hand every time.
apps/web/src/migrations/*.json

# Written by `backup:export`, byte for byte, in a fixed key order and sorted by
# code so its diff is the alarm (see apps/web/src/backup/permanence.ts). Prettier
# reformatting it would be one more thing that changes the file without a code
# changing, which is exactly what the format is built to avoid. The script owns it.
backups/*.json

# Build output and dependencies.
**/.next/
**/dist/
**/node_modules/
**/.turbo/
pnpm-lock.yaml
