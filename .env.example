# ===========================================================================
# Vardenia environment variables
#
# Copy this file to .env and fill it in. Never commit .env: it holds passwords.
# Setup walkthrough: docs/DATABASE-SETUP.md
#
# Three places hold these values, and each one needs its own:
#   .env              your machine, pointed at the DEVELOPMENT database
#   .env.prod         your machine, for running a script against PRODUCTION
#                     (see "Running scripts against production" at the end)
#   Netlify           Site configuration > Environment variables, for the live site
#
# Values never need quotes. An unquoted '#' starts a comment, so a value
# containing one is cut short silently: generate secrets as base64url (letters,
# digits, '-' and '_' only) and the problem cannot happen.
#
# NEXT_PUBLIC_ variables are compiled into the build. Changing one needs a
# redeploy on Netlify, and a dev server restart locally.
# ===========================================================================


# --- Database and core (required) ------------------------------------------

# Supabase connection string, TRANSACTION pooler (port 6543).
# Dashboard: Project Settings > Database > Connection string > Transaction pooler
#
# Migrations need the SESSION pooler (port 5432) instead, because the
# transaction pooler cannot hold the session a schema change needs. You never
# edit this for that: on Netlify, scripts/deploy-migrate.sh swaps the port
# itself before every production deploy, and locally the command in
# docs/DATABASE-SETUP.md does the same.
#
# Use the pooler rather than the "Direct connection" string: direct connections
# are IPv6-only unless you buy Supabase's IPv4 add-on, and most home and office
# networks are IPv4-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase's certificate authority, so the database connection is verified as
# well as encrypted. Optional but recommended in production.
#
# Without it every connection is still encrypted, but the server's identity is
# not checked. With it, a connection to anything pretending to be Supabase is
# refused. Dashboard: Project Settings > Database > SSL Configuration >
# Download certificate. Paste the whole PEM on one line, writing \n where each
# line break was (Netlify and GitHub secrets also accept it as-is).
DATABASE_CA_CERT=

# Signs login sessions for every account type, and keys the hashes in the rate
# limiter. Any long random string, different in every environment. Changing it
# signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# This deployment's public address. Builds every QR code, email link and
# canonical URL, and decides which origins may call the API.
#   development: http://localhost:3000
#   production:  https://vardenia.com   (exactly this, no www, no trailing slash)
#
# QR codes encode this address permanently, so a print sheet generated against
# anything else (localhost, a *.netlify.app address) carries a "not for print"
# banner.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra origins allowed to call the API while signed in, comma-separated.
# Usually empty: NEXT_PUBLIC_SITE_URL and its www twin are always allowed.
# Every entry can act as a signed-in customer, partner or staff member, so add
# only hosts you control. Wildcards are ignored on purpose.
PAYLOAD_EXTRA_ORIGINS=


# --- Launch switches --------------------------------------------------------

# Puts the "coming soon" splash in front of the public site. Only the exact
# value `true` turns it on. /admin and the API stay reachable. Read per request
# by src/proxy.ts, though Netlify still needs a redeploy to pick up a change.
COMING_SOON=

# Unlocks the real site while the splash is up: visit
# https://vardenia.com/?preview=<this value> once and a cookie lets you in for a
# month. Long and unguessable. Unset with COMING_SOON=true seals the site to
# everyone except localhost. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
COMING_SOON_PREVIEW_TOKEN=

# Whether search engines may index this deployment. Only the exact value `true`
# allows it; anything else means no. Turn it on in production once the
# directory has real content, and never on a preview or staging deployment.
# The admin dashboard warns for as long as it is off.
NEXT_PUBLIC_ALLOW_INDEX=


# --- Media storage ----------------------------------------------------------

# "local" writes uploads to apps/web/public/media, fine for a quick local
# setup. "s3" is required anywhere the filesystem is replaced on each deploy
# (Netlify), or uploaded photos disappear.
MEDIA_STORAGE_ADAPTER=local

# Read only when MEDIA_STORAGE_ADAPTER=s3. Supabase Storage is S3-compatible.
# Dashboard: Storage > S3. Create the bucket, mark it public, then generate an
# access key. Development and production are separate Supabase projects, so
# each has its own endpoint and keys: never mix them (see the end of the file).
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=eu-central-1    (Supabase: the project's region; "auto" is for R2)
S3_BUCKET=media
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where browsers load the files from. Derived automatically for Supabase; set
# it only if images 404 in the browser while uploads succeed.
#   S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
S3_PUBLIC_BASE_URL=


# --- Email ------------------------------------------------------------------

# Resend, for password resets, verification, booking emails and statements.
# The key and the sender are needed together. With either missing, email is
# printed to the terminal instead of sent: fine locally, silent failure in
# production (the admin dashboard warns).
RESEND_API_KEY=
EMAIL_FROM=noreply@vardenia.com

# The sender name recipients see. Empty means "Vardenia".
EMAIL_FROM_NAME=

# Redirects EVERY outgoing email to this one address. For staging only.
# Must be empty in production: set there, every send "succeeds" and no customer
# receives anything (the dashboard reports it in red).
EMAIL_OVERRIDE_TO=

# Who is emailed the first time a new error appears (once per distinct bug).
# Errors are always listed in the admin under Analytics > Error Events; this
# only adds the notification. Use an address a person reads.
ERROR_ALERT_TO=


# --- Billing ----------------------------------------------------------------

# How a venue pays its monthly booking-fee statement, printed at the bottom of
# every invoice (/invoice/<id>): Whish number, bank, account holder, IBAN.
# Write \n where a new line should start. Empty, the invoice asks the venue to
# wait for details, so set it before sending the first statement.
BILLING_PAYMENT_INSTRUCTIONS=


# --- Scheduled jobs ---------------------------------------------------------

# The password the scheduler uses to call /booking/expire, which declines the
# booking requests nobody answered before their time and tells each guest.
# netlify/functions/expire-bookings.mts sends it every 15 minutes. Any long
# random string; empty refuses every call, so nothing is ever declined.
# Production only, in Netlify (Functions and Runtime scopes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# --- Bot protection on sign-up (Cloudflare Turnstile) -----------------------

# Both together, or neither. With either empty the sign-up form works without a
# challenge (rate limiting still applies). Cloudflare dashboard > Turnstile >
# add the site; the site key is public, the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- Public site extras -----------------------------------------------------

# The team's WhatsApp number for the button on every public page, in
# international form (+961 3 123 456). Empty hides the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cookieless analytics. Nothing loads unless SRC and one identifier are set,
# so local and preview builds stay out of the numbers. Nothing here is secret.
#   Umami:     NEXT_PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
#              NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=<the id from the Umami dashboard>
#   Plausible: NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#              NEXT_PUBLIC_ANALYTICS_DOMAIN=vardenia.com
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_DOMAIN=


# --- Machine translation (optional) -----------------------------------------

# A LibreTranslate server that pre-fills the other languages when a listing is
# saved. Empty turns it off. Self-hosted (e.g. http://localhost:5000) needs no
# key; a hosted one needs LIBRETRANSLATE_API_KEY. Output deserves a native
# review before it is published.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=


# --- Seeding and tests (development only) -----------------------------------

# Which database `pnpm seed` and `pnpm seed:reset` may write to. They refuse
# unless this matches the database DATABASE_URL points at, so empty means
# "refuse". Format: DATABASE_URL without password or port. Run either script
# once and the error prints the identity you are pointed at.
#   SEED_ALLOWED_DB=postgres.<dev-project-ref>@aws-0-eu-central-1.pooler.supabase.com/postgres
# Development only. Never production: the seed writes invented businesses and
# reset deletes by id.
SEED_ALLOWED_DB=

# The accounts the seed creates. Leave these commented out to use the defaults
# (admin@vardenia.local, staff@vardenia.local). Do not set them to empty: an
# empty value replaces the default with nothing.
# SEED_ADMIN_EMAIL=admin@vardenia.local
# SEED_ADMIN_PASSWORD=<a password for the local admin>
# SEED_STAFF_EMAIL=staff@vardenia.local

# Integration tests refuse any database that is not on this machine. `yes`
# overrides that. Leave unset unless you are certain.
# INTEGRATION_ALLOW_REMOTE_DB=yes


# --- Mobile app -------------------------------------------------------------

# Read by apps/mobile (Expo exposes only EXPO_PUBLIC_ variables). On a real
# phone, localhost is the phone itself: use your computer's LAN address, for
# example http://192.168.1.20:3000/api.
EXPO_PUBLIC_API_URL=http://localhost:3000/api


# ===========================================================================
# Set elsewhere, not in this file
#
#   MIGRATE_DATABASE_URL   Netlify, optional. A session-pooler (5432) URL for
#                          deploy migrations; when unset it is derived from
#                          DATABASE_URL by swapping the port.
#   BACKUP_DATABASE_URL    GitHub > Settings > Secrets > Actions. Used by the
#                          nightly QR backup; should be a read-only role.
#   DATABASE_CA_CERT       also add it to Netlify and the GitHub secrets.
#
# ===========================================================================
# Running scripts against production (.env.prod)
#
# Scripts load .env.prod over .env:
#   set -a && . ./.env.prod && set +a
# Anything .env.prod does not set falls through to the DEVELOPMENT value in
# .env. That is how, on 2 September 2026, production photos were uploaded to
# the development storage bucket. So .env.prod must set every variable whose
# production value differs: the database, the secret, the site address, all of
# storage, and SEED_ALLOWED_DB set to empty so a seed can never run there.
# ===========================================================================
