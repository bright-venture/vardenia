# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env, it holds passwords.
# Setup walkthrough: docs/DATABASE-SETUP.md
# ---------------------------------------------------------------------------


# --- Required to start the app ---------------------------------------------

# Supabase connection string. Use the POOLED one (port 6543).
# Dashboard: Project Settings > Database > Connection string > URI > Transaction pooler
#
# When running a migration, temporarily swap in the SESSION POOLER string
# (port 5432). The transaction pooler cannot hold the session a schema change
# needs. Put the transaction pooler string back afterwards.
#
# Use the session pooler rather than the "Direct connection" string: direct
# connections are IPv6-only unless you buy Supabase's IPv4 add-on, and most
# home and office networks are IPv4-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Signs login tokens for the admin panel. Any long random string.
# Generate one with:  openssl rand -base64 32
# Use a different value in every environment. Changing it logs everyone out.
PAYLOAD_SECRET=change-me-in-every-environment

# Where this instance is reachable. Used to build QR redirect targets and to
# lock down which origins may call the API, so it must match the real address
# in production (https://vardenia.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Media storage ----------------------------------------------------------

# "local" writes uploads to disk under apps/web/public/media. Fine while
# developing. Switch to "s3" before deploying anywhere that replaces the
# filesystem on each release, or uploaded photos disappear.
MEDIA_STORAGE_ADAPTER=local

# Only read when MEDIA_STORAGE_ADAPTER=s3. Supabase Storage is S3-compatible,
# so these work with a Supabase bucket as well as with Cloudflare R2 or AWS S3.
#   S3_ENDPOINT for Supabase: https://<ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# --- Mobile app -------------------------------------------------------------

# Read by apps/mobile. Expo only exposes variables starting with EXPO_PUBLIC_.
# On a physical phone, localhost means the phone itself, so use your computer's
# LAN address instead (for example http://192.168.1.20:3000/api).
EXPO_PUBLIC_API_URL=http://localhost:3000/api


# --- Not wired up yet -------------------------------------------------------
# Listed so the shape is agreed in advance. Nothing reads these today, so
# setting them has no effect until the matching feature is built.

# Map rendering on the directory and listing pages (Phase 1).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Transactional email: password resets, listing enquiries (Phase 2).
# Until this exists, Payload prints emails to the terminal instead of sending.
RESEND_API_KEY=
EMAIL_FROM=noreply@vardenia.com
