# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env, it holds passwords.
# Setup walkthrough: docs/DATABASE-SETUP.md
# ---------------------------------------------------------------------------


# --- Required to start the app ---------------------------------------------

# Supabase connection string. Use the POOLED one (port 6543).
# Dashboard: Project Settings > Database > Connection string > URI > Transaction pooler
#
# When running a migration, temporarily swap in the SESSION POOLER string
# (port 5432). The transaction pooler cannot hold the session a schema change
# needs. Put the transaction pooler string back afterwards.
#
# Use the session pooler rather than the "Direct connection" string: direct
# connections are IPv6-only unless you buy Supabase's IPv4 add-on, and most
# home and office networks are IPv4-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Signs login tokens for the admin panel. Any long random string.
# Use a different value in every environment. Changing it logs everyone out.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# base64url, not base64. An unquoted '#' anywhere in a value starts a comment
# here, so the rest of the line is silently dropped and Payload reports the
# secret as missing. base64url emits only letters, digits, '-' and '_', so that
# cannot happen. The same trap applies to the database password.
PAYLOAD_SECRET=change-me-in-every-environment

# Where this instance is reachable. Used to build QR redirect targets and to
# lock down which origins may call the API, so it must match the real address
# in production (https://vardenia.com).
#
# QR codes encode this host permanently, so a print sheet generated against
# anything temporary carries a "not for print" banner. That includes a working
# deploy preview like vardenia.vercel.app, not only localhost: the danger is a
# sheet that looks finished while pointing at an address we stop owning.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra origins allowed to reach the API, comma-separated. Usually empty.
#
# NEXT_PUBLIC_SITE_URL and its www counterpart are always allowed, so this is
# only for additional hostnames serving the same app - the *.netlify.app address
# while it is still in use, or a staging deployment.
#
# These feed both `cors` and `csrf`. The csrf half decides which pages may make
# a request carrying somebody's auth cookie, so every entry here is a site that
# can act as a logged-in customer, owner or staff member. Add nothing you do not
# control. A wildcard is ignored on purpose.
PAYLOAD_EXTRA_ORIGINS=

# Whether search engines may index this deployment. Only the exact value `true`
# enables it; unset means no.
#
# Held back at launch so Google's first crawl does not land on an empty
# directory. Set it to true and redeploy once there is content worth finding -
# it is compiled into the build, so changing it alone does nothing.
#
# It fails closed on purpose, which means forgetting it leaves the site
# invisible to search with nothing visibly broken. The admin dashboard shows a
# "Not indexed by search engines" warning the whole time it is off, which is the
# only thing standing between that and a very quiet launch.
#
# Also worth leaving off on any staging or preview deployment, so it never
# competes with the real site in search results.
NEXT_PUBLIC_ALLOW_INDEX=

# Which database `pnpm seed` and `pnpm seed:reset` are allowed to touch.
#
# Both scripts refuse unless this matches the database DATABASE_URL points at.
# There is no default: unset means refuse, because a guard that only works once
# somebody configures it is off wherever a step was skipped.
#
# The format is user@host/database, which is DATABASE_URL without the password
# or port. The user matters most - every Supabase project in a region shares one
# pooler hostname, so the project ref in the username is the only thing telling
# dev and production apart. Run either script once and the error prints the
# identity of whatever you are currently pointed at.
#
#   SEED_ALLOWED_DB=postgres.<dev-ref>@aws-0-eu-central-1.pooler.supabase.com/postgres
#
# Set it to development. Never to production: the seed writes invented
# businesses, and reset deletes by id, which in another database means deleting
# whatever happens to sit at those numbers.
SEED_ALLOWED_DB=


# --- Media storage ----------------------------------------------------------

# "local" writes uploads to disk under apps/web/public/media. Fine while
# developing. Switch to "s3" before deploying anywhere that replaces the
# filesystem on each release, or uploaded photos disappear.
MEDIA_STORAGE_ADAPTER=local

# Only read when MEDIA_STORAGE_ADAPTER=s3. Supabase Storage is S3-compatible,
# so these work with a Supabase bucket as well as with Cloudflare R2 or AWS S3.
#
# Supabase: Storage > S3 in the dashboard. Create the bucket first, mark it
# public, then generate an access key. Endpoint and region are shown there.
#   S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=eu-central-1        (must match the project region, not auto)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Where a browser reads the files from, which is a different address
# to the S3 endpoint above. Derived automatically for Supabase; set this only if
# uploaded images 404 in the browser while uploads themselves succeed.
#   S3_PUBLIC_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public/media
S3_PUBLIC_BASE_URL=


# --- Mobile app -------------------------------------------------------------

# Read by apps/mobile. Expo only exposes variables starting with EXPO_PUBLIC_.
# On a physical phone, localhost means the phone itself, so use your computer's
# LAN address instead (for example http://192.168.1.20:3000/api).
EXPO_PUBLIC_API_URL=http://localhost:3000/api


# --- Not wired up yet -------------------------------------------------------
# Listed so the shape is agreed in advance. Nothing reads this today, so setting
# it has no effect until the matching feature is built.

# Map rendering on the directory and listing pages.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Transactional email ----------------------------------------------------
# Password resets, and booking confirmations once those exist. Wired through
# @payloadcms/email-resend; see apps/web/src/lib/email.ts.
#
# Both of the first two are required together. With either missing, Payload
# falls back to printing messages to the terminal - which is fine locally and
# means a password reset is silently never delivered in production, so the admin
# dashboard warns for as long as that is the case.
RESEND_API_KEY=
EMAIL_FROM=noreply@vardenia.com

# The display name a recipient sees. Defaults to Vardenia.
EMAIL_FROM_NAME=

# Redirects EVERY outgoing message to this one address, whoever it was addressed
# to. Meant for a staging deployment, where the alternative is emailing real
# customers with test data.
#
# Leave empty in production. Set here, every send still succeeds and every
# customer receives nothing - a failure with no error anywhere, which is why the
# dashboard reports it in red rather than as a warning.
EMAIL_OVERRIDE_TO=
