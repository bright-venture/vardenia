    "@vardenia/api-client": "workspace:*",
    "@vardenia/core": "workspace:*",
    "@vardenia/i18n": "workspace:*",
    "@vardenia/tokens": "workspace:*",
    "graphql": "^16.10.0",
    "lucide-react": "^1.33.0",
    "next": "^15.1.4",
    "next-intl": "^4.13.7",
    "payload": "^3.20.0",
