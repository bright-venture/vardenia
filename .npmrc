# apps/web is on React 19 (Next 15); apps/mobile is on React 18 (Expo 52 / RN 0.76).
# Both must coexist, which the default isolated node-linker handles - with two caveats:

# 1. pnpm hoists transitive deps into node_modules/.pnpm/node_modules, where a single
#    @types/react wins the slot. React Native's 18.x was landing there, and TypeScript in
#    apps/web walked up and found it instead of its own 19.x. Exclude React types from
#    hoisting so each app resolves its own.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom

# 2. auto-install-peers would satisfy third-party `@types/react` peer ranges with an 18.x
#    copy inside the React 19 app. Leave it off.
auto-install-peers=false

strict-peer-dependencies=false
