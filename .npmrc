# Both apps are on React 19: apps/web via Next 15, apps/mobile via Expo 57 / RN 0.86.
#
# That was not always true. Mobile sat on React 18 until the Expo 52 -> 57 upgrade,
# and the settings below exist because of the mess that caused. They are kept, at
# narrower stakes, because the versions still differ by minor:

# 1. pnpm hoists transitive deps into node_modules/.pnpm/node_modules, where a single
#    @types/react wins the slot. React Native's copy was landing there and TypeScript
#    in apps/web walked up and found it instead of its own. Excluding the React types
#    from hoisting makes each app resolve the version it declares, which matters
#    whenever the two drift - as they do today (web ^19.0.4, mobile ~19.2.18).
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom

# 2. auto-install-peers would quietly satisfy a third-party `@types/react` peer range
#    with whichever copy it liked. Leave it off and let each app declare its own.
auto-install-peers=false

strict-peer-dependencies=false
