{
  "name": "vardenia",
  "version": "0.1.0",
  "private": true,
  "description": "Lebanon tourism & lifestyle discovery platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vardenia/web",
    "dev:mobile": "turbo run dev --filter=@vardenia/mobile",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,mjs}": "prettier --write"
  },
  "devDependencies": {
    "@vardenia/tsconfig": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.29.1",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.5",
      "vite": "^6.4.3",
      "fast-uri": "^3.1.8",
      "esbuild": "^0.25.0",
      "@xmldom/xmldom@^0.9.0": "^0.9.12",
      "js-yaml@^4.0.0": "^4.3.2",
      "source-map-js": "^1.2.2",
      "fast-copy@^3.0.0": "^3.1.0",
      "@xmldom/xmldom@^0.8.0": "^0.8.15",
      "shell-quote": "^1.11.0",
      "compression": "^1.8.2",
      "brace-expansion@^5.0.0": "^5.0.12"
    }
  }
}
